# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is git-ignored — never commit real secrets.

# Password Postgres uses to initialize the "db" service on first startup
# (also used as DB_PASSWORD below unless you customize Postgres init).
POSTGRES_PASSWORD=change-me

# Postgres role/user the backend connects with (also creates this role in the db container).
DB_USERNAME=sifipro

# Password for DB_USERNAME. Must match POSTGRES_PASSWORD for the default single-role setup.
DB_PASSWORD=change-me

# Secret key used to sign JWT access tokens. Use a long, random value (32+ bytes).
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=change-me-generate-a-long-random-secret
